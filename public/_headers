# Cloudflare Pages 的缓存策略。
# 默认所有资源都是 max-age=0, must-revalidate——图片每次访问都要回服务器问一遍。
# 作品图和封面基本不会变，给一周的强缓存，重访时整组图片直接走本地。

/works/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/covers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# /assets/ 下的文件名带内容哈希，内容一变名字就变，可以放心 immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
